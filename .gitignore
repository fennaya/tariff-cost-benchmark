.venv/
__pycache__/
*.pyc
.env
*.key
data/processed/_dryrun_llm_logs/

# Raw USITC HTS revision dumps (255 MB, 21 files): not tracked. A trimmed, gzip-compressed
# copy (9 MB; only the fields the analysis reads) is tracked under data/compact/hts_revisions/
# and the scripts fall back to it automatically. Rebuild the raw files with
# scripts/fetch_hts.py (see README, "Rebuilding the raw data").
data/raw/hts_revisions/

logs/

# Older (2022-2025) USITC HTS releases, fetched by scripts/fetch_older_hts.py; a compact
# code index (data/compact/hts_older/) is tracked instead.
data/raw/hts_older_pdf/

# Local run logs from Round 3 (tracebacks contain local paths)
logs_guardrail*.txt
logs_fetch_older_hts.txt

# v1.1 run logs written by the daily job and the model runs (local only)
run_logs/openrouter_daily.log
run_logs/nemotron_run*.txt
run_logs/gpt6sol_run*.txt
run_logs/baseten_probes*.txt
run_logs/v1_2_full_runs.txt
